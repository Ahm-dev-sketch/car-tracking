{
  "name": "kcic-fleet",
  "version": "0.1.0",
  "description": "Sistem pelacakan armada kendaraan dan driver operasional KCIC",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:all": "npm test && npm run test:integration",
    "retention:run": "node --experimental-strip-types src/server/tracking/retention.ts",
    "dispatch:sweep": "tsx scripts/dispatch-sweep.mjs",
    "realtime:dev": "node scripts/realtime-dev.mjs",
    "db:seed:demo": "node --experimental-strip-types prisma/seed-demo.ts",
    "dev:all": "concurrently \"next dev\" \"node scripts/realtime-dev.mjs\"",
    "deploy:build": "opennextjs-cloudflare build",
    "deploy:dry": "opennextjs-cloudflare deploy --dry-run",
    "deploy": "opennextjs-cloudflare deploy"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/exceljs": "^0.5.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1",
    "ws": "^8.22.1"
  }
}
