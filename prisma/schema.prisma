datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleCode {
  ADMIN
  USER
  DRIVER

  @@map("Role")
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
  INACTIVE
}

enum VehicleType {
  SEDAN
  SUV
  MPV
  VAN
  TRUCK
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_TRIP
}

model Role {
  id        String   @id @default(cuid())
  code      RoleCode @unique
  name      String
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String
  roleId       String   @map("role_id")
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  driver       Driver?

  @@index([roleId])
  @@map("users")
}

model Vehicle {
  id              String         @id @default(cuid())
  plateNumber     String         @unique @map("plate_number")
  brand           String
  model           String
  vehicleType     VehicleType    @map("vehicle_type")
  seatingCapacity Int            @map("seating_capacity")
  transmission    Transmission?
  imageUrl        String?        @map("image_url")
  status          VehicleStatus  @default(AVAILABLE)
  currentDriverId String?        @unique @map("current_driver_id")
  currentDriver   Driver?        @relation("VehicleCurrentDriver", fields: [currentDriverId], references: [id], onDelete: SetNull)
  assignedDriver  Driver?        @relation("DriverCurrentVehicle")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([seatingCapacity])
  @@map("vehicles")
}

model Driver {
  id               String       @id @default(cuid())
  userId           String       @unique @map("user_id")
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  licenseNumber    String       @unique @map("license_number")
  status           DriverStatus @default(OFFLINE)
  currentVehicleId String?      @unique @map("current_vehicle_id")
  currentVehicle   Vehicle?     @relation("DriverCurrentVehicle", fields: [currentVehicleId], references: [id], onDelete: SetNull)
  drivenVehicle    Vehicle?     @relation("VehicleCurrentDriver")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("drivers")
}
