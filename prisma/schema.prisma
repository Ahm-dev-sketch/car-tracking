datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleCode {
  ADMIN
  USER
  DRIVER

  @@map("Role")
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
  INACTIVE
}

enum VehicleType {
  SEDAN
  SUV
  MPV
  VAN
  TRUCK
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_TRIP
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  SEARCHING_DRIVER
  DRIVER_NOTIFIED
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVER_AVAILABLE
  ADMIN_INTERVENTION
}

enum OfferStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum DriverSessionStatus {
  ACTIVE
  ENDED
}

enum TripStatus {
  ACTIVE
  COMPLETED
  ABORTED
}

enum MovementStatus {
  MOVING
  STOPPED
  GPS_LOST
  OFFLINE
}

model Location {
  id        String   @id @default(cuid())
  name      String
  code      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  homeVehicles               Vehicle[] @relation("VehicleHomeLocation")
  currentVehicles            Vehicle[] @relation("VehicleCurrentLocation")
  bookings                   Booking[]

  @@index([code])
  @@map("locations")
}

model Role {
  id        String   @id @default(cuid())
  code      RoleCode @unique
  name      String
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  phone         String
  roleId        String         @map("role_id")
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  avatarUrl     String?        @map("avatar_url")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  driver        Driver?
  auditLogs     AuditLog[]
  bookings      Booking[]
  notifications Notification[]

  @@index([roleId])
  @@map("users")
}

model Vehicle {
  id              String              @id @default(cuid())
  plateNumber     String              @unique @map("plate_number")
  brand           String
  model           String
  vehicleType     VehicleType         @map("vehicle_type")
  seatingCapacity Int                 @map("seating_capacity")
  transmission    Transmission?
  imageUrl        String?             @map("image_url")
  status          VehicleStatus       @default(AVAILABLE)
  currentDriverId String?             @unique @map("current_driver_id")
  currentDriver   Driver?             @relation("VehicleCurrentDriver", fields: [currentDriverId], references: [id], onDelete: SetNull)
  assignedDriver  Driver?             @relation("DriverCurrentVehicle")
  homeLocationId    String?           @map("home_location_id")
  homeLocation      Location?         @relation("VehicleHomeLocation", fields: [homeLocationId], references: [id], onDelete: SetNull)
  currentLocationId String?           @map("current_location_id")
  currentOperationalLocation Location? @relation("VehicleCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  assignments       VehicleAssignment[]
  bookings          Booking[]
  preferredBookings Booking[]         @relation("BookingVehiclePreference")
  trips             Trip[]
  currentLocation   VehicleLocation?
  driverLocations   DriverLocation[]
  driverSessions    DriverSession[]

  @@index([status])
  @@index([seatingCapacity])
  @@map("vehicles")
}

model Driver {
  id               String              @id @default(cuid())
  userId           String              @unique @map("user_id")
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  licenseNumber    String              @unique @map("license_number")
  status           DriverStatus        @default(OFFLINE)
  currentVehicleId String?             @unique @map("current_vehicle_id")
  currentVehicle   Vehicle?            @relation("DriverCurrentVehicle", fields: [currentVehicleId], references: [id], onDelete: SetNull)
  drivenVehicle    Vehicle?            @relation("VehicleCurrentDriver")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  assignments      VehicleAssignment[]
  bookings         Booking[]
  trips            Trip[]
  vehicleLocations VehicleLocation[]
  driverLocations  DriverLocation[]
  sessions         DriverSession[]
  offers           BookingOffer[]

  @@map("drivers")
}

model VehicleAssignment {
  id           BigInt    @id @default(autoincrement())
  vehicleId    String    @map("vehicle_id")
  driverId     String    @map("driver_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  reason       String?

  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver       Driver    @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([vehicleId])
  @@map("vehicle_assignments")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id")
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model Booking {
  id                    String        @id @default(cuid())
  bookingNumber         String        @unique @map("booking_number")
  userId                String        @map("user_id")
  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicleId             String?       @map("vehicle_id")
  vehicle               Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId              String?       @map("driver_id")
  driver                Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  operationalLocationId String        @map("operational_location_id")
  operationalLocation   Location      @relation(fields: [operationalLocationId], references: [id], onDelete: Restrict)
  vehiclePreferenceId   String?       @map("vehicle_preference_id")
  vehiclePreference     Vehicle?      @relation("BookingVehiclePreference", fields: [vehiclePreferenceId], references: [id], onDelete: SetNull)
  pickupLocation        String        @map("pickup_location")
  destination           String
  pickupLat             Float?        @map("pickup_lat")
  pickupLng             Float?        @map("pickup_lng")
  destinationLat        Float?        @map("destination_lat")
  destinationLng        Float?        @map("destination_lng")
  departureAt           DateTime      @map("departure_at")
  expectedReturnAt      DateTime      @map("expected_return_at")
  passengerCount        Int           @map("passenger_count")
  purpose               String
  notes                 String?
  status                BookingStatus @default(PENDING)
  cancelledReason       String?       @map("cancelled_reason")
  rejectedReason        String?       @map("rejected_reason")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  trips                 Trip[]
  offers                BookingOffer[]

  @@index([status, departureAt])
  @@index([userId])
  @@index([vehicleId, departureAt, expectedReturnAt])
  @@index([operationalLocationId])
  @@map("bookings")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model Trip {
  id               String            @id @default(cuid())
  bookingId        String?           @map("booking_id")
  booking          Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  vehicleId        String            @map("vehicle_id")
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId         String            @map("driver_id")
  driver           Driver            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  startedAt        DateTime          @default(now()) @map("started_at")
  endedAt          DateTime?         @map("ended_at")
  startLat         Float             @map("start_lat")
  startLng         Float             @map("start_lng")
  endLat           Float?            @map("end_lat")
  endLng           Float?            @map("end_lng")
  distanceMeters   Float?            @map("distance_meters")
  status           TripStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  vehicleLocations VehicleLocation[]
  driverLocations  DriverLocation[]

  @@index([vehicleId, startedAt(sort: Desc)])
  @@index([driverId, startedAt(sort: Desc)])
  @@map("trips")
}

model VehicleLocation {
  vehicleId  String         @id @map("vehicle_id")
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId   String         @map("driver_id")
  driver     Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripId     String?        @map("trip_id")
  trip       Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  lat        Float
  lng        Float
  accuracyM  Float          @map("accuracy_m")
  speedMps   Float?         @map("speed_mps")
  headingDeg Float?         @map("heading_deg")
  recordedAt DateTime       @map("recorded_at")
  receivedAt DateTime       @default(now()) @map("received_at")
  movement   MovementStatus @default(OFFLINE)

  @@map("vehicle_locations")
}

model DriverLocation {
  id         BigInt   @default(autoincrement())
  driverId   String   @map("driver_id")
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String   @map("vehicle_id")
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId     String?  @map("trip_id")
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  lat        Float
  lng        Float
  accuracyM  Float    @map("accuracy_m")
  speedMps   Float?   @map("speed_mps")
  headingDeg Float?   @map("heading_deg")
  recordedAt DateTime @map("recorded_at")
  receivedAt DateTime @default(now()) @map("received_at")

  @@id([id, recordedAt])
  @@index([driverId, recordedAt(sort: Desc)])
  @@map("driver_locations")
}

model BookingOffer {
  id           String      @id @default(cuid())
  bookingId    String      @map("booking_id")
  booking      Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driverId     String      @map("driver_id")
  driver       Driver      @relation(fields: [driverId], references: [id], onDelete: Restrict)
  attemptNo    Int         @map("attempt_no")
  status       OfferStatus @default(SENT)
  sentAt       DateTime    @default(now()) @map("sent_at")
  expiresAt    DateTime    @map("expires_at")
  respondedAt  DateTime?   @map("responded_at")
  rank         Int
  etaSeconds   Int?        @map("eta_seconds")
  etaEstimated Boolean     @default(false) @map("eta_estimated")

  @@index([bookingId, attemptNo])
  @@index([driverId, status])
  @@index([status, expiresAt])
  @@map("booking_offers")
}

model DriverSession {
  id        String              @id @default(cuid())
  driverId  String              @map("driver_id")
  driver    Driver              @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId String?             @map("vehicle_id")
  vehicle   Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status    DriverSessionStatus @default(ACTIVE)
  startedAt DateTime            @default(now()) @map("started_at")
  endedAt   DateTime?           @map("ended_at")
  startLat  Float?              @map("start_lat")
  startLng  Float?              @map("start_lng")
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([driverId, status])
  @@map("driver_sessions")
}
